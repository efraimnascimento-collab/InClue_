# ==========================================
# INCLUE - Git Ignore
# ==========================================

# Dependências do Node.js
backend/node_modules/
node_modules/

# Arquivos de configuração e variáveis de ambiente
.env
.env.*
!.env.example

# Uploads gerados pelo sistema
backend/uploads/avaliacoes/*
backend/uploads/perfis/*

# Mantém as pastas de uploads no Git
!backend/uploads/avaliacoes/.gitkeep
!backend/uploads/perfis/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Arquivos temporários
*.tmp
*.temp
*.swp
*.swo

# Arquivos do sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Configurações de editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/

# Arquivos de build e cache
dist/
build/
.cache/
.tmp/

# Arquivos de cobertura de testes
coverage/

# Backups
*.bak
*.backup

# Arquivos de banco de dados locais
*.sqlite
*.sqlite3